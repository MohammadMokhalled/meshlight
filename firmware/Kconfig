# Shared lighting options for the application and its production-module tests.
mainmenu "Meshlight configuration"

source "Kconfig.zephyr"

menu "Lighting"

config LIGHTING_SAVE_DELAY_MS
	int "Quiet period before saving lighting (milliseconds)"
	default 1000
	range 1 60000

config LIGHTING_SAVE_RETRY_MS
	int "Delay before retrying a failed lighting save (milliseconds)"
	default 5000
	range 1 60000

config LIGHTING_PERSISTENCE_STACK_SIZE
	int "Lighting persistence worker stack size (bytes)"
	default 3072
	range 1024 8192

config LIGHTING_AUTO_REFRESH
	bool "Automatically refresh the LED strip"
	default y
	depends on LED_STRIP && MULTITHREADING
	select TIMEOUT_64BIT
	select LOG_RATELIMIT if LOG
	help
	  Start a private lighting thread after successful lighting initialization.
	  Setters update requested values, which appear on the next refresh.
	  Disable to use synchronous lighting_apply() calls exclusively.
	  Manual flushes remain available when the worker is enabled.

if LIGHTING_AUTO_REFRESH

config LIGHTING_REFRESH_INTERVAL_MS
	int "Lighting refresh interval (milliseconds)"
	default 50
	range 1 1000
	help
	  Time between scheduled frame starts. Late transfers skip missed slots
	  rather than queueing frames. This does not change WS2812 signal timing.

config LIGHTING_REFRESH_STACK_SIZE
	int "Lighting refresh thread stack size (bytes)"
	default 1536
	range 512 8192
	help
	  Statically allocated supervisor stack for rendering, the synchronous
	  strip driver, and rate-limited error logging. Adjust for the driver used.

endif # LIGHTING_AUTO_REFRESH

endmenu

config MESHLIGHT_DEV_SHELL
	bool "Developer UART shell"
	default n
	select SHELL
	select SHELL_BACKEND_SERIAL if !ZTEST
	help
	  Enable lighting commands over the board's existing debugger UART.
	  Disabled builds contain no developer shell commands or transport.
	  Use dev_shell.conf to enable this option in a developer build.
	  Commands use the lighting API and its normal background save policy.
