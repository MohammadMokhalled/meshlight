#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	chosen {
		zephyr,code-partition = &app_partition;
	};
	aliases {
		/* The lighting module depends only on this board-independent alias. */
		led-strip = &lighting_strip;
	};
};

/* Standalone image boots at zero; retain the SDK's final 36 KiB for Settings. */
/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
&cpuapp_rram {
	partitions {
		app_partition: partition@0 {
			label = "image-0";
			reg = <0 0x15c000>;
		};
	};
};

&pinctrl {
	lighting_spi_default: lighting_spi_default {
		group1 {
			/* Connect P1.12 to DIN; reserve P1.11 but leave it unconnected. */
			psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
				<NRF_PSEL(SPIM_MOSI, 1, 12)>;
		};
	};

	lighting_spi_sleep: lighting_spi_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
				<NRF_PSEL(SPIM_MOSI, 1, 12)>;
			low-power-enable;
		};
	};
};

/* SPI21 shares an instance with I2C21/UART21, which remain disabled. */
&spi21 {
	status = "okay";
	pinctrl-0 = <&lighting_spi_default>;
	pinctrl-1 = <&lighting_spi_sleep>;
	pinctrl-names = "default", "sleep";

	lighting_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		/* One source of truth for both the driver and application buffer. */
		chain-length = <6>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
		/*
		 * Five 250 ns SPI bits give an 800 kbit/s WS2812 symbol:
		 * zero = 11000 (500 ns high), one = 11100 (750 ns high).
		 * No MISO or chip-select connection is required.
		 */
		spi-max-frequency = <4000000>;
		bits-per-symbol = <5>;
		spi-zero-frame = <0x18>;
		spi-one-frame = <0x1c>;
		/* Covers the longer latch interval required by newer strip variants. */
		reset-delay = <300>;
	};
};
