# Build directories (Zephyr/west, CMake, and Android/Gradle).
# Keep buildSrc/ and build-logic/ available for Gradle build scripts.
build/
build-*/
!build-logic/
build_*/
cmake-build-*/

# Zephyr/west workspace metadata and test output.
.west/
twister-out*/

# CMake/Ninja files generated by in-source builds.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CMakeUserPresets.json
build.ninja
rules.ninja
.ninja_deps
.ninja_log

# Android/Gradle caches, native build output, and local SDK paths.
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
local.properties
captures/
*.apk
*.aab
*.ap_
*.hprof

# Local Android signing credentials. Keep these outside version control.
*.jks
*.keystore
keystore.properties
key.properties

# Python tooling used by Zephyr.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local editor settings.
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# Operating system metadata.
.DS_Store
Thumbs.db
Desktop.ini
